{
  "manifest_version": 3,
  "name": "AdBlock YouTube",
  "short_name": "AdBlock YT",
  "description": "Rimuove le pubblicità dai video e dai feed di YouTube in Safari.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["youtube-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["youtube-content.js"],
      "css": ["youtube.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["youtube-main.js"],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ]
    }
  ]
}
